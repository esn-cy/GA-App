{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "environment",
      "description": "The environment you target",
      "type": "pickString",
      "options": [
        "dev",
        "prod"
      ],
      "default": "dev"
    }
  ],
  "tasks": [
    {
      "label": "Deploy a back-end environment",
      "type": "shell",
      "command": "node",
      "args": [
        "cli",
        "deploy",
        "backend",
        "--stage",
        "${input:environment}"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Quickly deploy Lambda fn source code changed (dev back-end)",
      "type": "shell",
      "command": "node",
      "args": [
        "cli",
        "deploy",
        "quick",
        "--stage",
        "dev"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Show logs of back-end environment",
      "type": "shell",
      "command": "node",
      "args": [
        "cli",
        "logs",
        "--stage",
        "${input:environment}"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Release a front-end environment",
      "type": "shell",
      "command": "node",
      "args": [
        "cli",
        "deploy",
        "frontend",
        "--stage",
        "${input:environment}"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "GA App CLI: Interactive Menu",
      "type": "shell",
      "command": "node",
      "args": [
        "cli"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "GA App CLI: Doctor",
      "type": "shell",
      "command": "node",
      "args": [
        "cli",
        "doctor"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
