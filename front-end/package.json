{
  "name": "esn-assembly",
  "version": "1.10.2",
  "author": "Matteo Carbone",
  "homepage": "https://matteocarbone.com/",
  "scripts": {
    "ng": "ng",
    "start": "ionic serve --no-open",
    "lint": "eslint --ext .ts",
    "test": "ng test --watch=false",
    "test:coverage": "ng test --watch=false --code-coverage",
    "bundle-report": "ng build --stats-json && webpack-bundle-analyzer www/stats.json",
    "postinstall": "mkdir -p node_modules/@env && echo '{\"name\":\"@env\",\"version\":\"1.0.0\",\"module\":\"../../src/environments/environment.ts\",\"main\":\"../../src/environments/environment.ts\"}' > node_modules/@env/package.json && node scripts/patch-coverage.js"
  },
  "private": true,
