{
  "extends": "./node_modules/@tsconfig/node-lts/tsconfig.json",
  "compilerOptions": {
    "lib": [
      "es2020"
    ],
    "module": "node16",
    "moduleResolution": "node16",
    "target": "es2020",
    "sourceMap": true,
    "strictPropertyInitialization": false,
    "strictNullChecks": false,
    "useDefineForClassFields": false
  },
  "include": [
    "src/**/*.ts",
    "deploy/**/*.ts"
  ]
}
